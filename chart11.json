{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Capital Gains Tax Breakdown by Entity and Asset Type",
  "width": 400,
  "height": 400,
  "data": {
    "url": "chart_data11.csv",
    "format": {
      "type": "csv",
      "parse": {
        "amount": "number"
      }
    }
  },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "asset_type",
          "type": "nominal",
          "title": "Asset Type"
        },
        "y": {
          "field": "entity",
          "type": "nominal",
          "title": "Entity"
        },
        "color": {
          "field": "amount",
          "type": "quantitative",
          "title": "Amount",
          "scale": {
            "scheme": "greens"
          }
        },
        "tooltip": [
          {"field": "entity", "title": "Entity"},
          {"field": "asset_type", "title": "Asset Type"},
          {"field": "amount", "title": "Amount", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "asset_type",
          "type": "nominal"
        },
        "y": {
          "field": "entity",
          "type": "nominal"
        },
        "text": {
          "field": "amount",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.amount > 30",
            "value": "white"
          },
          "value": "black"
        }
      }
    }
  ]
}