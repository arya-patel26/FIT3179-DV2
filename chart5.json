{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": "Top Excise Tax Contributors",
  "data": {
    "url": "chart_data5.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "nominal",
          "axis": {"title": "Financial Year", "labelAngle": -45}
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {"domain": [10, 1]},
          "axis": {"title": "Rank", "tickCount": 10}
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "title": "Contributors",
          "scale": {"range": ["#999999", "#88CCEE", "#44AA99", "#117733", "#4477AA", "#B9A3E3", "#7B3F9E", "#332288", "#2563eb"]},
          "legend": null
        },
        "tooltip": [
          {"field": "financial_year", "type": "nominal", "title": "Year"},
          {"field": "source", "type": "nominal", "title": "Source"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {"field": "amount", "type": "quantitative", "title": "Contribution ($m)", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "nominal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {"domain": [10, 1]}
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "scale": {"range": ["#999999", "#88CCEE", "#44AA99", "#117733", "#4477AA", "#B9A3E3", "#7B3F9E", "#332288", "#2563eb"]},
          "legend": null
        },
        "tooltip": [
          {"field": "financial_year", "type": "nominal", "title": "Year"},
          {"field": "source", "type": "nominal", "title": "Source"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {"field": "amount", "type": "quantitative", "title": "Contribution ($m)", "format": ","}
        ]
      }
    },
    {
      "transform": [
        {"joinaggregate": [{"op": "max", "field": "financial_year", "as": "last_year"}], "groupby": ["source"]},
        {"filter": "datum.financial_year == datum.last_year"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 12, "fontWeight": 600, "color": "#374151"},
      "encoding": {
        "x": {"field": "financial_year", "type": "nominal"},
        "y": {"field": "rank", "type": "quantitative", "scale": {"domain": [10, 1]}},
        "text": {"field": "source", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "title": {"anchor": "start", "color": "#111827", "fontSize": 15, "fontWeight": 600},
    "axis": {
      "domainColor": "#d1d5db", "tickColor": "#d1d5db", "gridColor": "#e5e7eb",
      "labelColor": "#4b5563", "labelFontSize": 11,
      "titleColor": "#374151", "titleFontSize": 11, "titleFontWeight": 600
    }
  }
}