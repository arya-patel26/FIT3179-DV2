df <- read.csv("chart_data12.csv", stringsAsFactors = FALSE)
# 2. Clean and format columns
df_clean <- df %>%
mutate(
year = as.character(year),
top10 = as.integer(top10),
postcode = sprintf("%04d", as.numeric(postcode)), # Ensures 4-digit postcodes (e.g. "0800")
state = as.character(state),
suburb = as.character(suburb),
individuals = as.numeric(gsub(",", "", individuals)),
average_taxable_income = as.numeric(gsub(",", "", average_taxable_income))
)
library(dplyr)
library(readr)
df <- read.csv("chart_data12.csv", stringsAsFactors = FALSE)
# 2. Clean and format columns
df_clean <- df %>%
mutate(
year = as.character(year),
top10 = as.integer(top10),
postcode = sprintf("%04d", as.numeric(postcode)), # Ensures 4-digit postcodes (e.g. "0800")
state = as.character(state),
suburb = as.character(suburb),
individuals = as.numeric(gsub(",", "", individuals)),
average_taxable_income = as.numeric(gsub(",", "", average_taxable_income))
)
# 3. Export to CSV with quote = TRUE so embedded commas in suburbs don't break the columns
write.csv(df_clean, "chart_data13.csv", row.names = FALSE, quote = TRUE)
df <- read.csv("chart_data12.csv", stringsAsFactors = FALSE)
# 2. Clean and format columns
df_clean <- df %>%
mutate(
year = as.character(year),
top10 = as.integer(top10),
postcode = sprintf("%04d", as.numeric(postcode)), # Ensures 4-digit postcodes (e.g. "0800")
state = as.character(state),
suburb = as.character(suburb),
individuals = as.numeric(gsub(",", "", individuals)),
average_taxable_income = as.numeric(gsub(",", "", average_taxable_income))
)
# 3. Export to CSV with quote = TRUE so embedded commas in suburbs don't break the columns
write.csv(df_clean, "chart_data13.csv", row.names = FALSE, quote = TRUE)
