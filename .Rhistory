library(tidyverse)
# 1. Read your revised dataset
df <- read_csv("chart_data9.csv")
# 2. Group by the three categorical columns and sum the numerical values
df_collapsed <- df %>%
group_by(taxable_status, residency_status, tax_brackets) %>%
summarise(
individuals = sum(individuals, na.rm = TRUE),
taxable_income = sum(taxable_income, na.rm = TRUE),
.groups = "drop"
)
# 3. Save the clean aggregated CSV for your treemap
write_csv(df_collapsed, "chart_treemap_collapsed.csv")
# View the result
head(df_collapsed)
df_waffle <- tibble(
id = 1:100,
sex = c(rep("Male", 50), rep("Female", 50)),
location = c(
rep("NSW", 31), rep("VIC", 26), rep("QLD", 20),
rep("WA", 11), rep("SA", 7), rep("TAS", 2),
rep("ACT", 1), rep("NT", 1), rep("Overseas", 1), # Total 100
rep("NSW", 21), rep("VIC", 5) # Balancing remainder to 100 rows total
)[1:100],
generation = c(
rep("Gen Z", 21), rep("Gen Y", 34), rep("Gen X", 28),
rep("Baby Boomers", 14), rep("Silent Gen", 3)
)[sample(1:100, 100, replace = FALSE)],
lodgement = c(
rep("Tax Agent", 62), rep("MyTax", 37), rep("Paper", 1)
)[sample(1:100, 100, replace = TRUE)],
occupation = c(
rep("Blue collar", 24), rep("White collar", 39),
rep("Service sector", 17), rep("Unknown", 20)
)[sample(1:100, 100, replace = TRUE)],
tax_outcome = c(
rep("Refund", 71), rep("Owed tax", 23), rep("Balanced", 6)
)[sample(1:100, 100, replace = TRUE)]
)
# Save to CSV
write_csv(df_waffle, "chart_data10.csv")
