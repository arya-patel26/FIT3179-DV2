setwd("C:/Users/patel/Desktop/Semester 2 - 26/FIT3179/Assignment 2/Data")
library(dplyr)
library(tidyr)
# 1. Read your tax data
tax_raw <- read.csv("tax by bracket.csv", stringsAsFactors = FALSE)
# 2. Clean percentage values
tax_clean <- tax_raw %>%
mutate(
percent_individuals = as.numeric(gsub("%", "", percent_individuals)),
percent_net_tax = as.numeric(gsub("%", "", percent_net_tax)),
taxable_income = trimws(taxable_income)
)
# 3. Filter for a specific year (e.g., 2015-16) or keep all with a year dropdown
tax_long <- tax_clean %>%
select(year, taxable_income, percent_individuals, percent_net_tax) %>%
pivot_longer(
cols = c(percent_individuals, percent_net_tax),
names_to = "metric",
values_to = "percentage"
) %>%
mutate(
metric = ifelse(metric == "percent_individuals", "Individuals (%)", "Net Tax Contribution (%)")
)
# 4. Export for Vega-Lite
write.csv(tax_long, "tax_comparison_long.csv", row.names = FALSE)
print("Tax comparison data reshaped successfully!")
