{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Taxable Income by Postcode (2023–24)",
    "anchor": "start",
    "color": "#111827",
    "fontSize": 15,
    "fontWeight": 600,
    "dy": -10
  },
  "width": 800,
  "height": 650,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "titleColor": "#374151",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "labelFontSize": 10,
      "padding": 8,
      "orient": "bottom",
      "direction": "horizontal"
    }
  },
  "params": [
    {
      "name": "map_view",
      "value": [134, -27, 850],
      "bind": {
        "input": "select",
        "options": [
          [134, -27, 850],
          [146.5, -32.8, 2800],
          [144.8, -36.9, 4200],
          [145, -20, 1800],
          [135, -32, 2400],
          [122, -25.5, 1500],
          [146.6, -42.1, 8000],
          [133.4, -19.5, 2200],
          [149.0, -35.5, 30000]
        ],
        "labels": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "ACT"
        ],
        "name": "Map Centre: "
      }
    },
    {
      "name": "zoom_boost",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 5,
        "step": 0.1,
        "name": "Zoom Level: "
      }
    }
  ],
  "data": {
    "url": "POA_2021_AUST_GDA2020.json",
    "format": {
      "type": "topojson",
      "feature": "POA_2021_AUST_GDA2020"
    }
  },
  "transform": [
    {
      "lookup": "properties.POA_CODE21",
      "from": {
        "data": {
          "url": "chart_data1.csv",
          "format": {
            "type": "csv",
            "parse": {
              "postcode": "string",
              "avg_income": "number",
              "median_income": "number",
              "individuals": "number"
            }
          }
        },
        "key": "postcode",
        "fields": ["avg_income", "median_income", "individuals"]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "[map_view[0], map_view[1]]"},
    "scale": {"expr": "map_view[2] * zoom_boost"}
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 0.1
  },
  "encoding": {
    "color": {
      "field": "median_income",
      "type": "quantitative",
      "title": "Median Taxable Income ($)",
      "scale": {
        "scheme": "blues",
        "domain": [30000, 145000],
        "naColor": "#e5e7eb"
      }
    },
    "tooltip": [
      {"field": "properties.POA_CODE21", "title": "Postcode"},
      {"field": "median_income", "title": "Median Income", "format": "$,.0f"},
      {"field": "individuals", "title": "Individuals", "format": ","}
    ]
  }
}