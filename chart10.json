{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Anatomy of 100 Australian Taxpayers (2022–23)",
    "anchor": "start",
    "color": "#0f172a",
    "fontSize": 17,
    "fontWeight": 700,
    "dy": -12
  },
  "width": 450,
  "height": 450,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "legend": {
      "title": null,
      "labelColor": "#334155",
      "labelFontSize": 12,
      "symbolType": "square",
      "symbolSize": 160,
      "rowPadding": 6,
      "padding": 10,
      "orient": "right",
      "direction": "vertical"
    }
  },
  "params": [
    {
      "name": "selected_attr",
      "value": "sex",
      "bind": {
        "input": "select",
        "options": ["sex", "location", "generation", "lodgement", "occupation", "tax_outcome"],
        "labels": [
          "Sex",
          "Where they lived",
          "Generation",
          "How they lodged",
          "Occupation",
          "Tax Outcome"
        ],
        "name": "Select Attribute: "
      }
    }
  ],
  "data": {
    "url": "chart_data10.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "(datum.id - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.id - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "selected_attr == 'sex' ? datum.sex : selected_attr == 'location' ? datum.location : selected_attr == 'generation' ? datum.generation : selected_attr == 'lodgement' ? datum.lodgement : selected_attr == 'occupation' ? datum.occupation : datum.tax_outcome",
      "as": "active_category"
    }
  ],
  "mark": {
    "type": "square",
    "size": 1300,
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "descending"
    },
    "color": {
      "field": "active_category",
      "type": "nominal",
      "scale": {
        "range": ["#88CCEE", "#44AA99", "#117733", "#4477AA", "#B9A3E3", "#7B3F9E", "#332288", "#3182bd", "#999999"]
      }
    }
  }
}