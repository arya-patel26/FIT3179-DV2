{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Anatomy of 100 Australian Taxpayers (2022–23)",
    "anchor": "start",
    "color": "#111827",
    "fontSize": 15,
    "fontWeight": 600,
    "dy": -12
  },
  "width": 800,
  "height": 450,
  "config": {
    "background": "transparent",
    "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "legend": {
      "title": null,
      "labelColor": "#4b5563",
      "labelFontSize": 11,
      "symbolType": "square",
      "symbolSize": 160,
      "rowPadding": 6,
      "padding": 10,
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 10
    }
  },
  "params": [
    {
      "name": "selected_attr",
      "value": "sex",
      "bind": {
        "input": "select",
        "options": ["sex", "location", "generation", "lodgement", "occupation", "tax_outcome"],
        "labels": [
          "Sex",
          "Where they lived",
          "Generation",
          "How they lodged",
          "Occupation",
          "Tax Outcome"
        ],
        "name": "Select Attribute: "
      }
    }
  ],
  "data": {
    "url": "chart_data10.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "(datum.id - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.id - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "selected_attr == 'sex' ? datum.sex : selected_attr == 'location' ? datum.location : selected_attr == 'generation' ? datum.generation : selected_attr == 'lodgement' ? datum.lodgement : selected_attr == 'occupation' ? datum.occupation : datum.tax_outcome",
      "as": "active_category"
    },
    {
      "joinaggregate": [{"op": "count", "as": "cat_count"}],
      "groupby": ["active_category"]
    },
    {
      "joinaggregate": [{"op": "count", "as": "total_count"}]
    },
    {
      "calculate": "datum.cat_count / datum.total_count * 100",
      "as": "cat_pct"
    }
  ],
  "mark": {
    "type": "square",
    "size": 1000,
    "opacity": 1,
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "descending"
    },
    "color": {
      "field": "active_category",
      "type": "nominal",
      "scale": {
        "range": ["#7B3F9E", "#2563eb", "#88CCEE", "#44AA99", "#117733", "#4477AA", "#B9A3E3", "#332288", "#999999"]
      }
    },
    "tooltip": [
      {"field": "active_category", "type": "nominal", "title": "Category"},
      {"field": "cat_count", "type": "quantitative", "title": "People (out of 100)"}
    ]
  }
}