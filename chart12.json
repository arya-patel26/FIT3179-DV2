{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 650,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 750
  },
  "layer": [
    {
      "data": {
        "url": "POA_2021_AUST_GDA2021.json",
        "format": {"type": "topojson", "feature": "POA_2021_AUST_GDA2020"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "STE_2026_AUST_GDA2021.json",
        "format": {"type": "topojson", "feature": "STE_2026_AUST_GDA2020"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f3f4f6",
        "stroke": "#d1d5db",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "chart_data12.csv",
        "format": {
          "type": "csv",
          "parse": {"postcode": "string", "individuals": "number", "avg_taxable_income": "number", "top100": "number"}
        }
      },
      "transform": [
        {"calculate": "datum.postcode == '2052' ? '2033' : datum.postcode", "as": "poa_key"},
        {
          "lookup": "poa_key",
          "from": {
            "data": {
              "url": "POA_2021_AUST_GDA2020.json",
              "format": {"type": "topojson", "feature": "POA_2021_AUST_GDA2020"}
            },
            "key": "properties.POA_CODE21",
            "fields": ["geometry"]
          }
        },
        {"filter": "isValid(datum.geometry)"},
        {"calculate": "geoCentroid('projection', datum.geometry)[0]", "as": "cx"},
        {"calculate": "geoCentroid('projection', datum.geometry)[1]", "as": "cy"}
      ],
      "mark": {
        "type": "circle",
        "size": 90,
        "stroke": "#ffffff",
        "strokeWidth": 0.75,
        "opacity": 1
      },
      "encoding": {
        "x": {"field": "cx", "type": "quantitative", "scale": null, "axis": null},
        "y": {"field": "cy", "type": "quantitative", "scale": null, "axis": null},
        "order": {"field": "top100", "type": "quantitative", "sort": "descending"},
        "color": {
          "field": "top100",
          "type": "quantitative",
          "title": "Rank (1 = lowest average income)",
          "scale": {"domain": [1, 100], "range": ["#c2410c", "#fdba74"]},
          "legend": {"values": [1, 25, 50, 75, 100], "format": "d"}
        },
        "tooltip": [
          {"field": "top100", "type": "quantitative", "title": "Rank"},
          {"field": "postcode", "type": "nominal", "title": "Postcode"},
          {"field": "individuals", "type": "quantitative", "title": "Taxpayers", "format": ","},
          {"field": "avg_taxable_income", "type": "quantitative", "title": "Average Income", "format": "$,.0f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA", "lat": -25.0, "lon": 122.0},
          {"state": "NSW", "lat": -31.8, "lon": 147.0},
          {"state": "VIC", "lat": -36.6, "lon": 144.9},
          {"state": "ACT", "lat": -35.4, "lon": 149.1},
          {"state": "QLD", "lat": -22.5, "lon": 143.0},
          {"state": "SA", "lat": -30.0, "lon": 135.0},
          {"state": "TAS", "lat": -42.0, "lon": 146.5},
          {"state": "NT", "lat": -20.0, "lon": 133.0}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#4b5563",
        "dy": 0
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "title": {"anchor": "start", "color": "#111827", "fontSize": 15, "fontWeight": 600},
    "legend": {
      "titleColor": "#374151",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "labelFontSize": 11,
      "padding": 8,
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 320,
      "gradientThickness": 10
    }
  }
}
