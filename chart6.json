{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 700,
  "title": "Top 10 Australian Postcodes by Average Taxable Income (2010–11)",
  "params": [
    {
      "name": "map_view",
      "value": [134, -27, 850],
      "bind": {
        "input": "select",
        "options": [
          [134, -27, 850],
          [151.21, -33.87, 2200],
          [144.96, -37.81, 4000],
          [153.03, -27.47, 1200],
          [138.60, -34.93, 1800],
          [115.86, -31.95, 1000],
          [147.33, -42.88, 5500],
          [130.84, -12.46, 1200],
          [149.13, -35.28, 28000]
        ],
        "labels": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "ACT"
        ],
        "name": "Map Centre: "
      }
    },
    {
      "name": "zoom_boost",
      "value": 1,
      "bind": {"input": "range", "min": 1, "max": 25, "step": 0.5, "name": "Zoom: "}
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "[map_view[0], map_view[1]]"},
    "scale": {"expr": "map_view[2] * zoom_boost"},
    "translate": [400, 300]
  },
  "layer": [
    {
      "data": {
        "url": "POA_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "POA_2021_AUST_GDA2020"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f3f4f6",
        "stroke": "#d1d5db",
        "strokeWidth": 0.3
      }
    },
    {
      "data": {
        "url": "chart_data6.csv",
        "format": {"type": "csv", "parse": {"postcode": "string"}}
      },
      "transform": [
        {"filter": "datum.year == '2010–11'"},
        {
          "lookup": "postcode",
          "from": {
            "data": {
              "url": "POA_2021_AUST_GDA2020.json",
              "format": {"type": "topojson", "feature": "POA_2021_AUST_GDA2020"}
            },
            "key": "properties.POA_CODE21",
            "fields": ["geometry"]
          }
        },
        {"calculate": "geoCentroid('projection', datum.geometry)[0]", "as": "cx"},
        {"calculate": "geoCentroid('projection', datum.geometry)[1]", "as": "cy"}
      ],
      "mark": {
        "type": "circle",
        "size": 200,
        "fill": "#2563eb",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "opacity": 0.8
      },
      "encoding": {
        "x": {"field": "cx", "type": "quantitative", "scale": null, "axis": null},
        "y": {"field": "cy", "type": "quantitative", "scale": null, "axis": null},
        "tooltip": [
          {"field": "year", "type": "nominal", "title": "Financial Year"},
          {"field": "top10", "type": "quantitative", "title": "Rank"},
          {"field": "postcode", "type": "nominal", "title": "Postcode"},
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "suburb", "type": "nominal", "title": "Suburbs"},
          {"field": "average_taxable_income", "type": "quantitative", "title": "Avg Income ($)", "format": "$,.2f"},
          {"field": "individuals", "type": "quantitative", "title": "Individuals", "format": ",d"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}