{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "chart_data4.csv"
  },
  "vconcat": [
    {
      "width": 732,
      "height": 320,
      "title": "Tax Revenue Composition by Revenue Stream",
      "transform": [
          {"filter": "datum.entity_type != 'Total'"},
          {"calculate": "indexof(lower(datum.entity_type), 'income') >= 0 ? 1 : 0", "as": "is_income"}
      ],
      "mark": "area",
      "encoding": {
        "x": {
          "field": "income_year",
          "type": "nominal",
          "scale": {"domain": {"param": "brush"}},
          "axis": {"title": "Financial Year", "labelAngle": -45}
        },
        "y": {
          "field": "amount",
          "type": "quantitative",
          "title": "Tax Revenue ($m)"
        },
        "color": {
          "field": "entity_type",
          "type": "nominal",
          "title": "Revenue Stream",
          "sort": {"field": "is_income", "op": "max", "order": "descending"},
          "scale": {"range": ["#2563EB", "#88CCEE", "#44AA99", "#117733", "#4477AA", "#B9A3E3", "#7B3F9E", "#332288", "#999999"]}
        },
        "tooltip": [
          {"field": "income_year", "type": "nominal", "title": "Year"},
          {"field": "entity_type", "type": "nominal", "title": "Stream"},
          {"field": "amount", "type": "quantitative", "title": "Revenue ($m)", "format": ","}
        ]
      }
    },
    {
      "width": 732,
      "height": 80,
      "mark": {"type": "line", "color": "#1e40af", "strokeWidth": 2},
      "title": {"text": "Total Tax Revenue"},
      "transform": [
        {"filter": "datum.entity_type == 'Total'"}
      ],
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": ["x"],
            "mark": {"fill": "#2563eb", "fillOpacity": 0.12, "stroke": "#2563eb", "strokeOpacity": 0.6}
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "income_year",
          "type": "nominal",
          "axis": {"title": "Financial Year", "labelAngle": -45}
        },
        "y": {
          "field": "amount",
          "type": "quantitative",
          "title": "Tax Revenue ($m)",
          "axis": {"tickCount": 3, "grid": false}
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "title": {"anchor": "start", "color": "#111827", "fontSize": 15, "fontWeight": 600},
    "axis": {
      "domainColor": "#d1d5db", "tickColor": "#d1d5db", "gridColor": "#e5e7eb",
      "labelColor": "#4b5563", "labelFontSize": 11,
      "titleColor": "#374151", "titleFontSize": 11, "titleFontWeight": 600
    },
    "legend": {
      "titleColor": "#374151", "titleFontSize": 11, "titleFontWeight": 600,
      "labelColor": "#4b5563", "labelFontSize": 11, "symbolType": "square", 
      "orient": "top", "direction": "horizontal"
    }
  }
}